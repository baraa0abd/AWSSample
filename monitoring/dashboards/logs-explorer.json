{
  "uid": "logs-explorer",
  "title": "Logs / Explorer",
  "tags": ["logs"],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "type": 1, "label": "namespace", "stream": "" },
        "refresh": 2
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "type": 1, "label": "pod", "stream": "{namespace=\"$namespace\"}" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      { "name": "search", "label": "Contains", "type": "textbox", "query": "" }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Log lines per pod",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (pod) (count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} |= \"$search\" [$__auto]))", "legendFormat": "{{pod}}" }]
    },
    {
      "id": 2, "type": "logs", "title": "Logs",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 18 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [{ "refId": "A", "expr": "{namespace=\"$namespace\", pod=~\"$pod\"} |= \"$search\"" }]
    }
  ]
}
