# One environment = network -> security -> storage -> compute, plus the generated Ansible
# inventory. environments/{dev,prod} only differ in the values they pass.

locals {
  name_prefix = "${var.project_name}-${var.environment}"

  nodes = merge(
    { "server-0" = { role = "server", size = var.server_instance_type, data_disk_gb = var.server_data_disk_gb } },
    { for i in range(var.agent_count) : "agent-${i}" => { role = "agent", size = var.agent_instance_type, data_disk_gb = var.agent_data_disk_gb } },
  )

  # CI passes the key itself; locally it is read from disk. try(): linters run without the key file.
  ssh_public_key = var.ssh_public_key != null ? var.ssh_public_key : try(file(pathexpand(var.ssh_public_key_path)), null)

  # Ubuntu's AMIs create this user; root login is disabled.
  admin_username = "ubuntu"

  # Agents have no public IP: Ansible reaches them through the server.
  agent_ssh_args = "-o ProxyCommand=\"ssh -W %h:%p -q -o StrictHostKeyChecking=accept-new ${local.admin_username}@${module.compute.server_public_ip}\""
}

locals {
  inventory = {
    all = {
      vars = {
        ansible_user           = local.admin_username
        env                    = var.environment
        k3s_api_public_address = module.compute.server_public_ip
        k3s_tls_sans           = compact([module.compute.server_public_ip, var.domain])
        k3s_backup_bucket      = module.storage.backup_bucket
        k3s_backup_region      = var.region
        network_cidr           = var.vpc_cidr
      }
      children = {
        k3s_server = {
          hosts = {
            for k, n in module.compute.nodes : n.name => {
              ansible_host     = module.compute.server_public_ip
              node_ip          = n.private_ip
              data_disk_device = n.data_disk_device
            } if n.role == "server"
          }
        }
        k3s_agent = {
          hosts = {
            for k, n in module.compute.nodes : n.name => {
              ansible_host            = n.private_ip
              node_ip                 = n.private_ip
              data_disk_device        = n.data_disk_device
              ansible_ssh_common_args = local.agent_ssh_args
            } if n.role == "agent"
          }
        }
        # Hosts that build images with Docker. Empty by default: CI runners build.
        build = { hosts = {} }
      }
    }
  }
}

module "network" {
  source             = "../network"
  name_prefix        = local.name_prefix
  vpc_cidr           = var.vpc_cidr
  public_subnet_cidr = var.public_subnet_cidr
  nodes_subnet_cidr  = var.nodes_subnet_cidr
  availability_zone  = "${var.region}${var.availability_zone_suffix}"
}

module "security" {
  source              = "../security"
  name_prefix         = local.name_prefix
  vpc_id              = module.network.vpc_id
  vpc_cidr            = var.vpc_cidr
  allowed_admin_cidrs = var.allowed_admin_cidrs
}

module "storage" {
  source                = "../storage"
  name_prefix           = local.name_prefix
  availability_zone     = module.network.availability_zone
  data_disks            = { for k, n in local.nodes : k => n.data_disk_gb }
  force_destroy_backups = var.environment != "prod"
}

module "compute" {
  source             = "../compute"
  name_prefix        = local.name_prefix
  nodes              = { for k, n in local.nodes : k => { role = n.role, size = n.size } }
  public_subnet_id   = module.network.public_subnet_id
  nodes_subnet_id    = module.network.nodes_subnet_id
  security_group_id  = module.security.nodes_security_group_id
  data_disk_ids      = module.storage.data_disk_ids
  backup_bucket_arn  = module.storage.backup_bucket_arn
  ssh_public_key     = local.ssh_public_key
  auto_shutdown_cron = var.auto_shutdown_cron
}

# yamlencode instead of a hand-written template: cannot produce invalid YAML.
resource "local_file" "inventory" {
  filename        = var.inventory_path
  file_permission = "0644"
  content         = "# Generated by OpenTofu - do not edit.\n${yamlencode(local.inventory)}"

  lifecycle {
    precondition {
      condition     = local.ssh_public_key != null
      error_message = "No SSH public key: create ${var.ssh_public_key_path} (ssh-keygen -t ed25519) or set ssh_public_key."
    }
  }
}
