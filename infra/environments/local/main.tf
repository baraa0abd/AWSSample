# Local sample: the same provision -> configure -> deploy -> observe flow, but the "machines"
# are Docker containers running K3s. No cloud account needed. See docs/LOCAL.md.
terraform {
  required_version = ">= 1.10.0"

  required_providers {
    docker = {
      source  = "kreuzwerker/docker"
      version = "~> 3.6"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
  # Local state file (terraform.tfstate, gitignored): nothing to share for a laptop demo.
}

provider "docker" {}

variable "agent_count" {
  description = "Number of K3s agent containers"
  type        = number
  default     = 1
}

variable "k3s_image" {
  description = "K3s image; keep in step with k3s_version in ansible/group_vars/all.yml"
  type        = string
  default     = "rancher/k3s:v1.36.5-k3s1"
}

locals {
  name_prefix = "k3s-local"
  repo_root   = abspath("${path.module}/../../..")
  # ponytail: fixed join token. Fine for containers that never leave this machine.
  token = "local-demo-token"
  # Host ports -> what they reach. UIs are served by `kubectl port-forward` inside the server's
  # network namespace (scripts/local.sh), the app by Traefik.
  server_ports = {
    6443 = 16443 # Kubernetes API
    80   = 8080  # app through the Traefik ingress
    3000 = 3000  # Grafana
    9090 = 9090  # Prometheus
    9093 = 9093  # Alertmanager
  }
  agents = toset([for i in range(var.agent_count) : "agent-${i}"])
}

resource "docker_image" "k3s" {
  name         = var.k3s_image
  keep_locally = true
}

resource "docker_network" "cluster" {
  name = local.name_prefix
}

resource "docker_container" "server" {
  name       = "${local.name_prefix}-server-0"
  image      = docker_image.k3s.image_id
  hostname   = "${local.name_prefix}-server-0"
  privileged = true # K3s runs containerd and iptables inside the container
  restart    = "unless-stopped"
  command    = ["server", "--secrets-encryption", "--tls-san", "${local.name_prefix}-server-0"]
  env = [
    "K3S_TOKEN=${local.token}",
    "K3S_KUBECONFIG_OUTPUT=/output/local.yaml",
    "K3S_KUBECONFIG_MODE=644",
  ]

  tmpfs = {
    "/run"     = ""
    "/var/run" = ""
  }

  # K3s writes the kubeconfig straight into the repo's .kube/ directory.
  volumes {
    host_path      = "${local.repo_root}/.kube"
    container_path = "/output"
  }

  networks_advanced {
    name    = docker_network.cluster.name
    aliases = ["server"]
  }

  dynamic "ports" {
    for_each = local.server_ports
    content {
      internal = ports.key
      external = ports.value
      ip       = "127.0.0.1" # reachable from this machine only
    }
  }
}

resource "docker_container" "agent" {
  for_each   = local.agents
  name       = "${local.name_prefix}-${each.key}"
  image      = docker_image.k3s.image_id
  hostname   = "${local.name_prefix}-${each.key}"
  privileged = true
  restart    = "unless-stopped"
  command    = ["agent"]
  env = [
    "K3S_URL=https://server:6443",
    "K3S_TOKEN=${local.token}",
  ]

  tmpfs = {
    "/run"     = ""
    "/var/run" = ""
  }

  networks_advanced {
    name = docker_network.cluster.name
  }

  depends_on = [docker_container.server]
}

# Same hand-off as in the cloud environments: tofu writes the inventory Ansible reads.
resource "local_file" "inventory" {
  filename        = "${local.repo_root}/ansible/inventories/local/hosts.yml"
  file_permission = "0644"
  content = "# Generated by OpenTofu - do not edit.\n${yamlencode({
    all = {
      vars = {
        env             = "local"
        k3s_server_node = docker_container.server.name
        k3s_agent_nodes = [for a in docker_container.agent : a.name]
      }
      # The node containers have no SSH or Python: Ansible drives them through the Kubernetes API.
      hosts = { localhost = { ansible_connection = "local" } }
    }
  })}"
}

output "nodes" {
  description = "Cluster node containers"
  value       = concat([docker_container.server.name], [for a in docker_container.agent : a.name])
}

output "urls" {
  description = "Where to look once `scripts/local.sh up` has finished"
  value = {
    app          = "http://localhost:8080"
    grafana      = "http://localhost:3000"
    prometheus   = "http://localhost:9090"
    alertmanager = "http://localhost:9093"
  }
}
