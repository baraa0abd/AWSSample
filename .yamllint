---
extends: default
ignore: |
  k8s/chart/templates/
  ansible/inventories/
  .terraform/
  .ansible/
  secrets/
rules:
  line-length:
    max: 160
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    check-keys: false # GitHub Actions uses the key `on`
  document-start: disable
